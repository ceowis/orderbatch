<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.orderbatch.mapper.OrderMapper">

    <!-- 결과 매핑 -->
    <resultMap id="OrderResultMap" type="Order">
        <id     property="orderId"      column="order_id"/>
        <result property="customerId"   column="customer_id"/>
        <result property="customerName" column="customer_name"/>
        <result property="productCode"  column="product_code"/>
        <result property="productName"  column="product_name"/>
        <result property="quantity"     column="quantity"/>
        <result property="unitPrice"    column="unit_price"/>
        <result property="totalAmount"  column="total_amount"/>
        <result property="orderStatus"  column="order_status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="orderedAt"    column="ordered_at"/>
        <result property="processedAt"  column="processed_at"/>
        <result property="createdAt"    column="created_at"/>
        <result property="updatedAt"    column="updated_at"/>
    </resultMap>

    <!-- 특정 상태의 주문 조회 (배치 Reader용) -->
    <select id="selectOrdersByStatus" resultMap="OrderResultMap">
        SELECT
            order_id,
            customer_id,
            customer_name,
            product_code,
            product_name,
            quantity,
            unit_price,
            total_amount,
            order_status,
            ordered_at,
            processed_at,
            created_at,
            updated_at
        FROM orders
        WHERE order_status = #{status}
        ORDER BY order_id ASC
    </select>

    <!-- 주문 상태 업데이트 -->
    <update id="updateOrderStatus">
        UPDATE orders
        SET
            order_status = #{status},
            updated_at   = CURRENT_TIMESTAMP
        WHERE order_id = #{orderId}
    </update>

    <!-- 주문 처리 완료 처리 -->
    <update id="updateOrderProcessed">
        UPDATE orders
        SET
            order_status  = 'PROCESSED',
            processed_at  = CURRENT_TIMESTAMP,
            updated_at    = CURRENT_TIMESTAMP
        WHERE order_id = #{orderId}
          AND order_status = 'PENDING'
    </update>

    <!-- 주문 처리 실패 처리 -->
    <update id="updateOrderFailed">
        UPDATE orders
        SET
            order_status = 'FAILED',
            updated_at   = CURRENT_TIMESTAMP
        WHERE order_id = #{orderId}
    </update>

    <!-- 상태별 주문 수 조회 -->
    <select id="selectOrderCountByStatus" resultType="map">
        SELECT
            order_status,
            COUNT(*) AS cnt
        FROM orders
        GROUP BY order_status
    </select>

</mapper>
